/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self' 'unsafe-inline' 'unsafe-eval' blob: data: https://*.cloudflareinsights.com https://*.cloudflare.com; img-src 'self' blob: data: https://*.cloudflareinsights.com https://*.cloudflare.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: data: https://*.cloudflareinsights.com https://*.cloudflare.com; style-src 'self' 'unsafe-inline' blob: data: https://*.cloudflareinsights.com https://*.cloudflare.com; connect-src 'self' blob: data: https://*.cloudflareinsights.com https://*.cloudflare.com; media-src 'self' blob: data: https://*.cloudflareinsights.com https://*.cloudflare.com; frame-src 'self' blob: data: https://*.cloudflareinsights.com https://*.cloudflare.com; font-src 'self' blob: data: https://*.cloudflareinsights.com https://*.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; report-uri /csp-report
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), gyroscope=(), accelerometer=()
